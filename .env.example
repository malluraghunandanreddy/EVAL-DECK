# Copy to .env.local for local dev. In production set these in Vercel project env vars. Never commit real values.
APP_BASE_URL=http://localhost:3000
DATABASE_URL=postgres://user:pass@host:6543/postgres
SESSION_SECRET=
ENCRYPTION_KEY=          # 32 bytes, base64 (openssl rand -base64 32)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
PINELABS_CLIENT_ID=
PINELABS_CLIENT_SECRET=
PINELABS_MID=
PINELABS_ENV=uat
ADMIN_PASSWORD=
MCP_TOKEN=
AGENTICORG_API_KEY=
AGENTICORG_BASE_URL=https://agenticorg.hackathon.pinelabs.com
AGENTICORG_READER_AGENT_ID=
AGENTICORG_REVIEWER_AGENT_ID=
AGENTICORG_WORKFLOW_ID=
PRO_UNLOCK_CODES=        # comma-separated one-time codes for table-walk users (optional)
PINELABS_BASE_URL=        # optional override
PINELABS_WEBHOOK_SECRET=
PINELABS_CALLBACK_SECRET=
PINELABS_STRICT_SIGNATURE= # set 1 once signature schemes are confirmed
